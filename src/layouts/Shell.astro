---
/**
 * Shell.astro — the one shared shell. Chrome, the editorial container, the
 * sidenote gutter, and the exhibit foot nav.
 *
 * An illusion page passes its registry entry (`{ number, name, mechanism,
 * lede }`) and fills the seven named slots. The SCAFFOLD ORDER IS FIXED
 * HERE, in the layout — a page cannot reorder it, only fill it. Pages that
 * are not exhibits (the hub, /sources) use the default slot instead.
 *
 * A new exhibit must never need this file edited. See README, "the
 * graduation contract".
 */
import '@fontsource/archivo/latin-400.css';
import '@fontsource/archivo/latin-500.css';
import '@fontsource/archivo/latin-600.css';
import '@fontsource/fragment-mono/latin-400.css';
// Preload the self-hosted woff2 so the first text block paints in Archivo/Fragment
// Mono rather than a fallback that swaps and reflows (the page's one layout shift).
import archivo400 from '@fontsource/archivo/files/archivo-latin-400-normal.woff2?url';
import archivo500 from '@fontsource/archivo/files/archivo-latin-500-normal.woff2?url';
import archivo600 from '@fontsource/archivo/files/archivo-latin-600-normal.woff2?url';
import fragmentMono400 from '@fontsource/fragment-mono/files/fragment-mono-latin-400-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/exhibit.css';
import { ILLUSIONS, nextLiveAfter, type Illusion } from '../lib/illusions';

interface Props {
  title: string;
  description: string;
  /** Present only on an exhibit route. Drives the title, the chrome marker and the foot. */
  illusion?: Illusion;
}

const { title, description, illusion } = Astro.props;
const next = illusion ? nextLiveAfter(illusion.slug) : undefined;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// One build-time PNG per ship-1 route (scripts/og.ts); '/' maps to og/index.png.
const ogSlug = Astro.url.pathname.replace(/^\/+|\/+$/g, '') || 'index';
const ogImage = new URL(`${import.meta.env.BASE_URL}og/${ogSlug}.png`, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={archivo400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivo500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivo600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fragmentMono400} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "edf95770da9d443db1c7f7c3e5bef7c0"}'></script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="chrome">
      <div class="chrome-in">
        <a class="wordmark" href="/" aria-label="Statistical Illusions nobody has to lie, home">
          <b>Statistical Illusions</b>
          <span class="sub">nobody has to lie</span>
        </a>

        <nav aria-label="Site">
          <details class="menu">
            <summary>Illusions <span aria-hidden="true">▾</span></summary>
            <ol>
              {
                ILLUSIONS.map((i) => (
                  <li aria-current={illusion?.slug === i.slug ? 'page' : undefined}>
                    <span class="n">{i.number}</span>
                    {i.live ? <a href={`/${i.slug}`}>{i.name}</a> : <span class="off">{i.name}</span>}
                  </li>
                ))
              }
            </ol>
          </details>
          <a href="/sources" aria-current={Astro.url.pathname === '/sources' ? 'page' : undefined}>
            Sources
          </a>
        </nav>
      </div>
    </header>

    <main class="wrap" id="main">
      {
        illusion ? (
          <article class="piece">
            <div class="col">
              {/* The seven slots, in the one fixed order. */}
              <slot name="frame" />
              <slot name="setup" />
              <slot name="operate" />
              <slot name="commit" />
              <slot name="reveal" />
              <slot name="repair" />
              <slot name="debrief" />

              <div class="exfoot">
                <div class="ends">
                  <a class="link" href="/">&larr; back to the essay</a>
                  {next && (
                    <a class="link" href={`/${next.slug}`}>
                      Next illusion: {next.name} &rarr;
                    </a>
                  )}
                </div>
                <slot name="foot" />
              </div>
            </div>
          </article>
        ) : (
          <article class="piece">
            <div class="col">
              <slot />
            </div>
          </article>
        )
      }
    </main>

    <footer class="sitefoot">
      <slot name="sitefoot" />
      <!-- In the shell, not the essay, so all six pages are signed — the colophon's
           plain "Dustin Cole · dustincoledata.com" line said this on the home page only. -->
      <a class="dcd-mark" href="https://dustincoledata.com" target="_blank" rel="noopener"
         aria-label="A Dustin Cole Data project">
        <svg class="dcd-mark-logo" viewBox="3.8 17.1 56.5 29.8" aria-hidden="true" focusable="false">
          <g transform="translate(2.943 46.426) scale(0.040753 -0.040753)">
            <path fill="currentColor" d="M22 269Q22 388 88.5 468.0Q155 548 262 548Q345 548 408 488V718H579V0H422V61Q354 -10 262 -10Q155 -10 88.5 70.5Q22 151 22 269ZM200 269Q200 209 230.5 176.5Q261 144 303 144Q346 144 376.0 177.0Q406 210 406 270Q406 331 376.0 362.5Q346 394 303.0 394.0Q260 394 230.0 362.0Q200 330 200 269Z"/>
            <path fill="currentColor" transform="translate(605 0)" d="M293 -10Q173 -10 97.5 68.0Q22 146 22 269Q22 389 99.5 468.5Q177 548 293 548Q404 548 479.5 479.0Q555 410 566 298H384Q382 342 357.5 368.0Q333 394 294 394Q249 394 224.0 361.0Q199 328 199 269Q199 208 223.5 175.5Q248 143 294 143Q334 143 357.5 168.5Q381 194 384 240H566Q555 125 481.5 57.5Q408 -10 293 -10Z"/>
            <path class="dcd-mark-dot" transform="translate(1163 0)" d="M241 104Q241 56 211.0 25.5Q181 -5 133.0 -5.0Q85 -5 54.5 25.5Q24 56 24 104Q24 153 54.5 183.5Q85 214 133.0 214.0Q181 214 211.0 183.5Q241 153 241 104Z"/>
          </g>
        </svg>
        <i class="dcd-mark-rule" aria-hidden="true"></i>
        <span class="dcd-mark-words"><span class="dcd-mark-name">Dustin Cole</span><span class="dcd-mark-suffix">Data</span></span>
      </a>
    </footer>
    <style is:global>
      /* Left-aligned, not centred: the whole page hangs off one left rail. */
      .sitefoot .dcd-mark{display:inline-flex;align-items:center;gap:8px;margin-top:16px;
        padding:7px 12px 7px 10px;border-radius:999px;
        border:1px solid rgba(22,24,29,.10);
        text-decoration:none;line-height:1;opacity:.85;transition:opacity .2s ease,transform .2s ease;}
      .sitefoot .dcd-mark:hover{opacity:1;transform:translateY(-1px);}
      .sitefoot .dcd-mark:focus-visible{outline:2px solid #3B5BDB;outline-offset:2px;}
      /* The dc. logo: letters take the name's ink, the period stays brand blue on
         every site — it is the one part of the signature that never localises. */
      .dcd-mark-logo{height:13px;width:24.7px;flex:none;display:block;color:#16181D;}
      .dcd-mark-dot{fill:#3B5BDB;}
      .dcd-mark-rule{width:1px;height:13px;flex:none;background:rgba(22,24,29,.14);}
      .dcd-mark-words{display:inline-flex;align-items:baseline;gap:7px;}
      .dcd-mark-name{font-family:'Archivo',-apple-system,'Segoe UI','Helvetica Neue',Arial,sans-serif;
        font-weight:600;font-size:13px;letter-spacing:-.01em;color:#16181D;}
      .dcd-mark-suffix{font-family:ui-monospace,'Cascadia Code','Segoe UI Mono',Menlo,monospace;
        font-weight:500;font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:#565C68;}
      @media print{.dcd-mark{display:none;}}
      @media (prefers-reduced-motion:reduce){.dcd-mark{transition:none;}
        .sitefoot .dcd-mark:hover{transform:none;}}
    </style>
  </body>
</html>
